{
  "name": "frontend",
  "version": "0.2.2",
  "description": "Application to manage Open Vet Sim scenario archives.",
  "productName": "OVS Scenario Manager",
  "author": "David Haak <dh749@cornell.edu>",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint -c ./eslint.config.js --fix \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build --skip-pkg",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "axios": "^1.11.0",
    "pinia": "^3.0.3",
    "quasar": "^2.18.2",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.54.2",
    "@quasar/app-vite": "^2.3.0",
    "@types/node": "^24.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "openapi-typescript-codegen": "^0.29.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite-plugin-checker": "^0.10.2",
    "vue-tsc": "^3.0.5"
  },
  "engines": {
    "node": "^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
